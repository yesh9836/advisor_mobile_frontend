# Runtime environment
APP_ENV=staging
DEBUG=false

# Frontend (build-time)
# Must be absolute HTTPS and non-loopback for production frontend builds.
VITE_API_BASE_URL=https://app.example.com/api/v1
VITE_APP_BASE_PATH=
FRONTEND_PORT=8080
BACKEND_PORT=8000

# App origin settings
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=["https://app.example.com"]
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Database
DB_NAME=lead_management
DB_USER=lead_app
DB_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Security/admin bootstrap
SECRET_KEY=change_me_to_a_long_random_32_plus_char_secret
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Admin

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_EXPECT_LIVEMODE=false

# Sentry 
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_BREADCRUMBS=100
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional sourcemap upload during frontend build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Rate limiter
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=false

# Notifications/SMS
NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=smtp2go
NOTIFICATION_SMS_PROVIDER=twilio
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFICATION_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Worker tuning
STRIPE_POLL_INTERVAL_SECONDS=5
STRIPE_RECONCILE_INTERVAL_SECONDS=60
STRIPE_CLEANUP_INTERVAL_SECONDS=15
NOTIFICATION_WORKER_SLEEP_SECONDS=5
RETENTION_INTERVAL_SECONDS=3600
